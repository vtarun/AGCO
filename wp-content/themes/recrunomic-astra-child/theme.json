{
  "$schema": "https://schemas.wp.org/wp/6.3/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "recru-green", "color": "#2E8B57", "name": "Recrunomic Green" },
        { "slug": "recru-ivory", "color": "#FAF9F6", "name": "Ivory" },
        { "slug": "recru-gold", "color": "#D4AF37", "name": "Gold" },
        { "slug": "recru-charcoal", "color": "#333333", "name": "Charcoal" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "Inter, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Noto Sans, Apple Color Emoji, Segoe UI Emoji", "slug": "inter", "name": "Inter" }
      ]
    }
  },
  "styles": {
    "color": { "text": "#333333", "background": "#FAF9F6" },
    "elements": {
      "button": { "color": { "background": "#2E8B57", "text": "#ffffff" }, "border": { "radius": "10px" } }
    }
  }
}
